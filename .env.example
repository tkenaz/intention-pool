# PostgreSQL connection used by the Intention Pool MCP server.
# Copy this file to `.env` and fill in your own values.
PG_HOST=localhost
PG_PORT=5432
PG_DB=intention_pool
PG_USER=postgres
PG_PASSWORD=your_password_here

# Immutable provenance attached by the MCP server to every database mutation.
ACTOR_MODEL=claude
ACTOR_CLIENT=claude-desktop
